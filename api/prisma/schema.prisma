// Database schema. Every change goes through a migration (`prisma migrate dev`), never `db push`.
// Migrations stay compatible with the previous release: add first, remove in a later release.
// CHECK constraints live in the migrations only: Prisma does not model them and ignores them when it
// compares this schema with the database.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  // The api is ESM with "nodenext" resolution: relative imports need the .js extension.
  importFileExtension = "js"
  // For the partial unique index on fitting_sessions (one active session per user).
  previewFeatures     = ["partialIndexes"]
}

// The connection URL lives in prisma.config.ts; at runtime PrismaService connects through
// @prisma/adapter-pg.
datasource db {
  provider = "postgresql"
}

enum Gender {
  male
  female

  @@map("gender")
}

enum GenerationStatus {
  pending
  processing
  completed
  failed

  @@map("generation_status")
}

// What a fitting tries on (spec 0019 plan §2): one item or a look. Rows of the previous release
// have none and read as `single`.
enum FittingKind {
  single
  look

  @@map("fitting_kind")
}

// Why a fitting failed, for the user's text (spec 0019 plan §2); `error_message` keeps the detail.
enum FittingFailure {
  photo_dark
  photo_not_full
  photo_many_people
  photo_child
  photo_no_person
  prompt_refused
  model_timeout
  moderation
  provider_error

  @@map("fitting_failure")
}

// Better Auth writes users through its model `user` (api/src/auth/auth.ts): its `name` is
// `firstName`, `null` unless Google's given name passes the name rule (spec 0013 N5). Google gives
// no phone, so `phone` is unique only among the users that have one.
model User {
  id                     String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phone                  String?   @unique @db.VarChar(12)
  email                  String    @unique @db.VarChar(254)
  emailVerified          Boolean   @default(false) @map("email_verified")
  firstName              String?   @map("first_name") @db.VarChar(50)
  lastName               String?   @map("last_name") @db.VarChar(50)
  patronymic             String?   @db.VarChar(50)
  dateOfBirth            DateTime? @map("date_of_birth") @db.Date
  gender                 Gender?
  fittingProfileImageKey String?   @map("fitting_profile_image_key") @db.VarChar(255)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  fittingSessions FittingSession[]
  sessions        Session[]
  accounts        Account[]
  photos          UserPhoto[]
  fittingQuotas   FittingQuota[]
  generations     AiGeneration[]

  @@map("users")
}

// Better Auth's tables (spec 0013 plan §2). Only Better Auth writes them. A session row is the
// sign-in; the cookie holds its token.
model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token     String   @unique @db.VarChar(255)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  // Cut to 512 characters by the session hook.
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// A user's Google account. The token columns are Better Auth's and stay null: the account hook
// drops Google's tokens, since the api never calls Google after sign-in.
model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(255)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Short-lived values of Better Auth, e.g. the OAuth state of a sign-in in progress.
model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// The place of a category's products in a look (spec 0019 A18). A category without a slot takes no
// part in the fitting room.
enum OutfitSlot {
  top
  bottom
  outerwear
  shoes
  accessory

  @@map("outfit_slot")
}

model Category {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String      @unique @db.VarChar(255)
  slug        String      @unique @db.VarChar(255)
  isActive    Boolean     @map("is_active")
  description String?     @db.Text
  sortOrder   Int         @default(0) @map("sort_order")
  slot        OutfitSlot?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
}

model Product {
  id           String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  article      String                  @unique @db.VarChar(255)
  name         String                  @db.VarChar(255)
  description  String?                 @db.Text
  rating       Decimal?                @db.Decimal(2, 1)
  price        Decimal                 @db.Decimal(10, 2)
  discount     Int                     @default(0)
  brandId      String                  @map("brand_id") @db.Uuid
  categoryId   String                  @map("category_id") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  // The words of the name, the brand and the category (spec 0014, O14). The triggers of migration
  // 20261019120000_product_search own it, on writes to products, brands and categories: queries
  // never write it, and the client does not see it. The default only satisfies NOT NULL until the
  // trigger runs.
  searchVector Unsupported("tsvector") @default(dbgenerated("''::tsvector")) @map("search_vector")

  brand              Brand                   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category           Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  variations         ProductVariation[]
  attributeValues    ProductAttributeValue[]
  generationProducts GenerationProduct[]

  @@index([brandId])
  @@index([categoryId])
  // The search's GIN index, then one index per sort of the list, each ending with its `id desc`
  // tie-break (spec 0014, O17). The migration alone holds what Prisma does not model: `rating`'s NULLS LAST and the index on
  // `lower(article)`. They are built without CONCURRENTLY (a migration runs in a transaction); on a
  // large table a new one needs a separate step.
  @@index([searchVector], type: Gin, map: "products_search_vector_idx")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "products_created_at_id_idx")
  @@index([price, id(sort: Desc)], map: "products_price_asc_id_idx")
  @@index([price(sort: Desc), id(sort: Desc)], map: "products_price_desc_id_idx")
  @@index([discount(sort: Desc), id(sort: Desc)], map: "products_discount_id_idx")
  @@index([rating(sort: Desc), id(sort: Desc)], map: "products_rating_id_idx")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  imageKey  String   @map("image_key") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariation {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  size      String   @db.VarChar(20)
  stock     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
  @@map("product_variations")
}

model Attribute {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  values AttributeValue[]

  @@map("attributes")
}

// `colorHex` is a swatch colour, `#RRGGBB` (either case) or null (spec 0009, K12; CHECK in the
// migration).
model AttributeValue {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  value       String   @db.VarChar(255)
  colorHex    String?  @map("color_hex") @db.VarChar(7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  attribute          Attribute               @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  products           ProductAttributeValue[]
  generationProducts GenerationProduct[]

  @@unique([attributeId, value])
  @@map("attribute_values")
}

model ProductAttributeValue {
  productId        String   @map("product_id") @db.Uuid
  attributeValueId String   @map("attribute_value_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_attribute_values")
}

model FittingSession {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?  @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations      AiGeneration[]
  ownedGenerations AiGeneration[] @relation("GenerationSessionOwner")

  // The target of a generation's owner key (spec 0019 A65).
  @@unique([id, userId])
  // One active session per user (C15); the plain index serves the history list.
  // The generated client treats userId as a full unique key, but it is unique only among active
  // sessions: `where: { userId }` in findUnique/update/delete/upsert/connect may hit an archived
  // session. Always add `isActive: true`.
  @@unique([userId], where: raw("is_active"))
  @@index([userId])
  @@map("fitting_sessions")
}

// The status CHECK (migration 20261023120000_fittings): `completed` has a result and neither
// failure; `failed` has `failureCode` or `errorMessage`; `pending` and `processing` have none of the
// three. `fingerprint` is lower-case hex, `promptText` trimmed and not empty.
model AiGeneration {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId           String           @map("session_id") @db.Uuid
  // The session's user, so reads need no join (spec 0019 A23). Nullable while the previous release
  // inserts rows without it; NOT NULL comes in a later release (plan §2).
  userId              String?          @map("user_id") @db.Uuid
  // `null` on the previous release's rows: read as `single`.
  kind                FittingKind?
  // The photo the fitting used (A24); deleting it keeps the result.
  photoId             String?          @map("photo_id") @db.Uuid
  // The result this one regenerates; deleting that result keeps this one.
  parentId            String?          @map("parent_id") @db.Uuid
  promptText          String?          @map("prompt_text") @db.VarChar(300)
  // Values of A16's chips, checked by the DTO.
  regenerationReasons String[]         @default([]) @map("regeneration_reasons")
  countsAgainstLimit  Boolean          @default(true) @map("counts_against_limit")
  failureCode         FittingFailure?  @map("failure_code")
  providerRequestId   String?          @map("provider_request_id") @db.VarChar(100)
  // sha256 hex of the photo, the items and the text (A7, A32).
  fingerprint         String?          @db.Char(64)
  // A snapshot key of the closed route's rows (C14); the fittings reference `photoId` (A24).
  userImageKey        String?          @map("user_image_key") @db.VarChar(255)
  resultImageKey      String?          @map("result_image_key") @db.VarChar(255)
  status              GenerationStatus
  aiProvider          String           @map("ai_provider") @db.VarChar(50)
  aiModel             String           @map("ai_model") @db.VarChar(50)
  // A short message or code, not a provider's raw response (C23).
  errorMessage        String?          @map("error_message") @db.VarChar(1000)
  startedAt           DateTime?        @map("started_at") @db.Timestamptz(3)
  finishedAt          DateTime?        @map("finished_at") @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // The session, the photo and the parent belong to the row's user (A65): the three owner keys
  // reference `(id, user_id)`. The migration sets only `photo_id` or `parent_id` to NULL when the
  // photo or the parent goes (`SET NULL (column)`, which Prisma does not model), never `user_id`.
  // A row without `user_id` (the previous release's) has no photo and no parent, by a CHECK; its
  // session is still checked by the plain key. An owner never changes, so the owner keys do not
  // follow an update (NO ACTION): moving a session or a photo to another user fails.
  // Write `userId` (the principal's), `sessionId`, `photoId` and `parentId` only as scalars, never
  // through `connect`, `disconnect` or `set` of these relations: a `connect` by id copies the other
  // row's `userId`, a `disconnect` sets `userId` to NULL with the key.
  session      FittingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionOwner FittingSession?     @relation("GenerationSessionOwner", fields: [sessionId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo        UserPhoto?          @relation(fields: [photoId, userId], references: [id, userId], onDelete: SetNull, onUpdate: NoAction)
  parent       AiGeneration?       @relation("Regenerations", fields: [parentId, userId], references: [id, userId], onDelete: SetNull, onUpdate: NoAction)
  children     AiGeneration[]      @relation("Regenerations")
  products     GenerationProduct[]

  // The target of a regeneration's owner key.
  @@unique([id, userId])
  // One running generation per user and fingerprint (A32). The generated client treats the pair as
  // a full unique key, but it is unique only among running generations: a query by it always adds
  // the status filter. The condition is written as PostgreSQL stores it, or `migrate diff` sees
  // drift.
  @@unique([userId, fingerprint], where: raw("(status = ANY (ARRAY['pending'::generation_status, 'processing'::generation_status]))"))
  @@index([sessionId])
  @@index([userId, createdAt(sort: Desc)])
  // The repeat lookup (A7): the user, the fingerprint, then `status: 'completed'`.
  @@index([userId, fingerprint])
  @@index([photoId])
  @@index([parentId])
  @@map("ai_generations")
}

// A link is created with its generation, so it has no timestamps (C10). A fitting's item names its
// colour and its slot (plan §2); the closed route's links have neither.
model GenerationProduct {
  generationId     String      @map("generation_id") @db.Uuid
  productId        String      @map("product_id") @db.Uuid
  attributeValueId String?     @map("attribute_value_id") @db.Uuid
  slot             OutfitSlot?

  generation     AiGeneration    @relation(fields: [generationId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([generationId, productId])
  @@index([productId])
  @@index([attributeValueId])
  @@map("generation_products")
}

// A user's fitting photo (spec 0019 A24, A31): the server names the key (`keep/users/<userId>/…`),
// `sharp` re-encodes the file and sets `width` and `height`. A transient photo is a one-time one
// (A24): not among the five saved ones, deleted when its generation ends or after an hour unused.
model UserPhoto {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  imageKey  String   @map("image_key") @db.VarChar(255)
  isDefault Boolean  @default(false) @map("is_default")
  transient Boolean  @default(false)
  width     Int
  height    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations AiGeneration[]

  // The target of a generation's owner key (spec 0019 A65).
  @@unique([id, userId])
  // One default photo per user, the same partial index pattern as the active fitting session (0002
  // C21). The generated client treats userId as a full unique key, but it is unique only among
  // default photos: `where: { userId }` in findUnique/update/delete/upsert/connect may hit any
  // photo. Always add `isDefault: true`.
  @@unique([userId], where: raw("is_default"))
  @@index([userId])
  @@map("user_photos")
}

// A user's spend of the monthly fitting limit (spec 0019 A20), kept apart from the results so a
// deleted result gives nothing back. `month` is `YYYY-MM` in Moscow time. Written only by the start
// transaction of a fitting and by the workflow's `complete`.
model FittingQuota {
  userId String @map("user_id") @db.Uuid
  month  String @db.VarChar(7)
  used   Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, month])
  @@map("fitting_quota")
}

// What was deleted: part of the workflow id, so one row's deletion runs once at a time.
enum FileDeletionKind {
  user
  session
  generation
  photo

  @@map("file_deletion_kind")
}

// The outbox of file deletions (spec 0019 A38): a delete writes its folders here in its own
// transaction, FileDeletion starts the workflow `deleteFiles` after the commit and sets
// `startedAt`, the housekeeping schedule starts the rows left unstarted, and the workflow deletes
// its row when every folder is gone. `prefixes` are folders of storage/keys.ts.
model FileDeletion {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind      FileDeletionKind
  rowId     String           @map("row_id") @db.Uuid
  prefixes  String[]
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt DateTime?        @map("started_at") @db.Timestamptz(3)

  @@unique([kind, rowId])
  @@index([createdAt], where: raw("started_at IS NULL"))
  @@map("file_deletions")
}
