{
  "name": "lamoda-ai-fitting",
  "private": true,
  "engines": {
    "node": ">=26 <27",
    "npm": ">=12 <13"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "lint:css": "stylelint --max-warnings=0 \"web/**/*.scss\"",
    "typecheck": "npm --prefix api run typecheck && npm --prefix web run typecheck",
    "test": "node --test .claude/hooks/guards.test.mjs && npm --prefix api run test && npm --prefix web run test",
    "build": "npm --prefix api run build && npm --prefix web run build",
    "verify": "npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm test && npm run build"
  },
  "allowScripts": {},
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-react/eslint-plugin": "^5.24.4",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@playwright/mcp": "0.0.83",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
