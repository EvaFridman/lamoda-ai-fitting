# Values for docker-compose.yml (local development). Copy to .env (not in git) or run
# scripts/init-env.sh, which fills the passwords with random values. Service addresses are set in
# docker-compose.yml; production values live in GitHub (deploy/README.md), not here.

# Optional: Docker Compose project name (default ai-fitting). Containers, volumes and the api/web
# images are named after it; give a second copy (e.g. a git worktree) its own name and its own
# ports below so both run side by side (README.md).
COMPOSE_PROJECT_NAME=

# PostgreSQL. Letters and digits only in the password: it goes into a connection URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Admin token: requests that change data, or touch users, fitting sessions and generations, send it
# in the X-Admin-Token header. scripts/init-env.sh fills a random one (openssl rand -hex 32); empty
# closes those requests, a set one needs at least 32 characters without spaces.
ADMIN_API_TOKEN=
# Proxy secret: nginx and web send it to the api in the X-Proxy-Secret header; only such requests
# name the client's address (X-Forwarded-For) and the request id. scripts/init-env.sh fills a
# random one (openssl rand -hex 32); empty trusts no request, a set one needs at least 32 letters or
# digits.
PROXY_SECRET=
# Optional: a second proxy secret the api trusts too, set only while PROXY_SECRET is rotated
# (deploy/README.md); nginx and web never send it. Same format, empty by default.
PROXY_SECRET_NEXT=
# Optional: base address of catalog images, which web serves at /media/<key>; the api builds image
# URLs from it (default http://localhost:<WEB_HOST_PORT>/media/)
MEDIA_BASE_URL=
# Optional: the DSN of the api's Sentry project (not web's), for the api and the Temporal worker;
# empty turns Sentry off (default)
SENTRY_DSN=
# Optional: the environment name in Sentry (default NODE_ENV, development locally)
SENTRY_ENVIRONMENT=

# Optional: fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=
# Optional: requests per client address and route before 429, within 1 s (BURST) and 60 s
# (MINUTE), per quota tier: read = GET/HEAD (defaults 10 and 300), write = other methods (3 and
# 60), expensive = AI generations and uploads (1 and 10)
THROTTLE_READ_BURST=
THROTTLE_READ_MINUTE=
THROTTLE_WRITE_BURST=
THROTTLE_WRITE_MINUTE=
THROTTLE_EXPENSIVE_BURST=
THROTTLE_EXPENSIVE_MINUTE=
# Optional: the largest JSON body in bytes the api accepts, then 413 (default 102400, 100 KB)
BODY_LIMIT=
# Optional: milliseconds a request may run, then 503 (default 10000, at most 30000)
REQUEST_TIMEOUT_MS=
# Optional: the largest socket.io message in bytes; a bigger one closes a WebSocket and answers 413
# on long-polling (default 65536, 64 KB, at most 1048576)
SOCKET_MAX_MESSAGE_BYTES=

# Optional: ports on 127.0.0.1 (defaults: api 3000, web 3001, Postgres 5433, Redis 6380,
# Temporal UI 8233)
API_HOST_PORT=
WEB_HOST_PORT=
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=
TEMPORAL_UI_HOST_PORT=
