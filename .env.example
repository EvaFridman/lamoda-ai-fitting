# Values for docker-compose.yml (local development). Copy to .env (not in git) or run
# scripts/init-env.sh, which fills the passwords with random values. Service addresses are set in
# docker-compose.yml; production values live in GitHub (deploy/README.md), not here.

# Optional: Docker Compose project name (default ai-fitting). Containers, volumes and the api/web
# images are named after it; give a second copy (e.g. a git worktree) its own name and its own
# ports below so both run side by side (README.md).
COMPOSE_PROJECT_NAME=

# PostgreSQL. Letters and digits only in the password: it goes into a connection URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Proxy secret: nginx and web send it to the api in the X-Proxy-Secret header; only such requests
# name the client's address (X-Forwarded-For) and the request id. scripts/init-env.sh fills a
# random one (openssl rand -hex 32); empty trusts no request, a set one needs at least 32 letters or
# digits.
PROXY_SECRET=
# Optional: a second proxy secret the api trusts too, set only while PROXY_SECRET is rotated
# (deploy/README.md); nginx and web never send it. Same format, empty by default.
PROXY_SECRET_NEXT=
# Sign-in (spec 0013). The secret signs session cookies: scripts/init-env.sh fills a random one
# (openssl rand -hex 32); a set one needs at least 32 letters or digits and must differ from the
# proxy secrets. Required in production.
BETTER_AUTH_SECRET=
# Google's OAuth client: empty locally, where the compose service oidc (a fake Google) signs in
# instead; docker-compose.yml points AUTH_FAKE_OIDC_URL (the api's address of it) and
# AUTH_FAKE_OIDC_PUBLIC_URL (the browser's) at it. Production needs both Google values and refuses
# the fake provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: base address of catalog images, served at /media/<key> (locally next dev forwards it to
# the S3 emulator); the api builds image URLs from it (default http://localhost:<WEB_HOST_PORT>/media/)
MEDIA_BASE_URL=
# The keys of the local S3 emulator (SeaweedFS, the `s3` service): it creates its admin user from
# them, and the api and the Temporal worker sign with them. scripts/init-env.sh fills random ones;
# required, no spaces. Never production's keys.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: the bucket the emulator creates and the api uses (default ai-fitting)
S3_BUCKET=
# Optional: how long a signed link to a private file works, 60 to 3600 seconds (default 900)
S3_SIGNED_URL_TTL_SECONDS=
# The backup job (api/src/backup, spec 0012), run locally only by hand under the compose profile
# `backup`. Optional: its bucket in the emulator, other than S3_BUCKET (the profile's default
# ai-fitting-backups).
# Locally it reads and writes with the emulator's keys above; production has a read-only and a
# write-only key of its own (BACKUP_READ_*, BACKUP_WRITE_*), set in GitHub.
BACKUP_BUCKET=
# The age public key (age1…) local copies are encrypted to: make a pair of your own with
# `age-keygen`, never production's. Required only to run the backup job.
BACKUP_AGE_RECIPIENT=
# Optional: the DSN of the api's Sentry project (not web's), for the api and the Temporal worker;
# empty turns Sentry off (default)
SENTRY_DSN=
# Optional: the environment name in Sentry (default NODE_ENV, development locally)
SENTRY_ENVIRONMENT=
# Optional: Mixpanel's project token for web (public by design, it goes to the browser); empty
# turns analytics off (default). Locally only a dummy value for checks, never production's
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Optional: the site's address as the browser sees it, for absolute links in web's metadata
# (default http://localhost:<WEB_HOST_PORT>); production uses https://<SITE_DOMAIN>
SITE_URL=

# Optional: fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=
# Optional: requests per client address and route before 429, within 1 s (BURST) and 60 s
# (MINUTE), per quota tier: read = GET/HEAD (defaults 10 and 300), write = other methods (3 and
# 60), expensive = AI generations and uploads (1 and 10)
THROTTLE_READ_BURST=
THROTTLE_READ_MINUTE=
THROTTLE_WRITE_BURST=
THROTTLE_WRITE_MINUTE=
THROTTLE_EXPENSIVE_BURST=
THROTTLE_EXPENSIVE_MINUTE=
# Optional: the largest JSON body in bytes the api accepts, then 413 (default 102400, 100 KB)
BODY_LIMIT=
# Optional: milliseconds a request may run, then 503 (default 10000, at most 30000). Keep it at
# 6000 or more: a delete waits up to 5 s to start its file deletion (spec 0011 M26)
REQUEST_TIMEOUT_MS=
# Optional: the api's database pool (default 10 connections, at most 50), the milliseconds a
# statement may run (default 5000) and a query waits for a free connection (default 2000), then
# 503. The two timeouts together stay below REQUEST_TIMEOUT_MS, or the api does not start
DATABASE_POOL_MAX=
DATABASE_STATEMENT_TIMEOUT_MS=
DATABASE_CONNECTION_TIMEOUT_MS=
# Optional: the largest socket.io message in bytes; a bigger one closes a WebSocket and answers 413
# on long-polling (default 65536, 64 KB, at most 1048576)
SOCKET_MAX_MESSAGE_BYTES=
# Optional: seconds the product filter counts stay in Redis; a catalog change shows within them
# (default 60, 1 to 3600)
FACETS_CACHE_TTL_SECONDS=

# Optional: ports on 127.0.0.1 (defaults: api 3000, web 3001, Postgres 5433, Redis 6380,
# Temporal UI 8233, S3 emulator 8333, the fake Google's login page 4010)
API_HOST_PORT=
WEB_HOST_PORT=
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=
TEMPORAL_UI_HOST_PORT=
S3_HOST_PORT=
OIDC_HOST_PORT=
