# The site's only entry point. ${SITE_DOMAIN}, ${PROXY_SECRET}, ${NGINX_LOCAL_RESOLVERS},
# ${S3_ENDPOINT} and ${S3_BUCKET} are filled in by the image's entrypoint at start (and by deploy.sh
# on every deploy); nginx variables ($host, ...) are left alone.

# Docker's DNS: upstream names (api-blue, web-green, ...) are resolved at run time, so nginx starts
# even before the app containers exist and follows them when they are replaced.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

# Which colour serves traffic: written by deploy/scripts/deploy.sh, created as blue on first start.
include /etc/nginx/upstream/active.conf;

# WebSocket upgrade for socket.io; an empty Connection header keeps upstream keepalive for the rest.
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' '';
}

# The image's `main` format plus the request id, which the api logs too (spec 0006 F10). The image's
# access_log at http level would log a second line, so every server names this one.
log_format main_id '$remote_addr - $remote_user [$time_local] "$request" '
  '$status $body_bytes_sent "$http_referer" "$http_user_agent" request_id=$request_id';

# Edge limits per client address (spec 0006 F7, F8, F32): a coarse safety net above the api's own
# quotas, which stops a flood before Node, unknown routes and bodies the api refuses included. A
# burst passes at once (nodelay), what goes over it answers 429. `edge_*`: the upstream zones in
# active.conf are already named api and web. 10 MB holds about 160 000 addresses per zone.
limit_req_zone $binary_remote_addr zone=edge_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=edge_socket:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=edge_sockets:10m;
# Liveness has its own, generous zone: the deploy's request loop sends about 10 r/s to it from one
# address (spec 0006 F36).
limit_req_zone $binary_remote_addr zone=edge_health:10m rate=50r/s;
# web's pages, 3 times the peak of one measured catalog visit with its prefetches (11 r/s), and
# /media/, 3 times that visit's photos (10 r/s) with a burst of one batch's 60 photos (spec 0014
# O19, O24, O39, O109, O110). Next's static files have no limit: a page loads dozens of them.
# Read from the raw request line: nginx matches locations on the decoded path, Next on its own
# reading, so a path the two could read apart (%2F, %2e, `..`, `\`) counts as a page. An empty key
# is not counted. Chunk names keep only %5B and %5D (`[slug]`). A Range or a failing If-Match or
# If-Unmodified-Since makes Next render its error page (416, 412), so such a request counts too:
# the prefix breaks the match.
map "$http_range$http_if_match$http_if_unmodified_since" $edge_static_conditional {
  "" "";
  default "c";
}
map "$edge_static_conditional$request_method $request_uri" $edge_pages_key {
  "~^(GET|HEAD) /_next/static/(?!.*\.\.)([A-Za-z0-9._~/-]|%5[BbDd])*(\?.*)?$" "";
  default $binary_remote_addr;
}
limit_req_zone $edge_pages_key zone=edge_pages:10m rate=33r/s;
limit_req_zone $binary_remote_addr zone=edge_media:10m rate=30r/s;
# Requests one address has in progress anywhere on the site, slow bodies included (F36).
limit_conn_zone $binary_remote_addr zone=edge_conns:10m;
limit_req_status 429;
limit_conn_status 429;

# A slow client holds a connection only this long: the whole header, each pause in a body, each
# pause while it reads a response (F36). The limits above count a request only once its header is
# read, so these bound what they cannot see. keepalive_timeout is set per server: the image's
# nginx.conf sets it at this level already.
client_header_timeout 10s;
client_body_timeout 10s;
send_timeout 10s;

# The catalog media from the bucket (spec 0011 M3, M15): S3_ENDPOINT without a trailing slash,
# which proxy_pass would take for a path and send every request there; deploy.sh refuses any other
# form, which would leave $s3_origin empty and /media/ answering 503. A file is kept a day (its
# own Cache-Control), a missing one a minute; a key nobody asks for in a week is dropped.
map "${S3_ENDPOINT}" $s3_origin {
  "~^(?<origin>https?://[^/]+)/?$" $origin;
}
proxy_cache_path /var/cache/nginx/media levels=1:2 keys_zone=media:10m max_size=1g inactive=7d
  use_temp_path=off;

# nginx's own CSP, only for an answer without a policy that forbids framing already: web's pages
# carry their full one with `frame-ancestors 'none'` (spec 0014 plan §5), and two policies
# intersect, so a second would add nothing there. Everything else (the api, /media/, nginx's own
# errors, Next's /_next/image and Swagger's files) gets `frame-ancestors 'none'` (spec 0006 F9),
# an upstream policy that allows any framing too: the browser applies both. An empty value sends
# no header.
map $upstream_http_content_security_policy $edge_csp {
  "~*(^|;)\s*frame-ancestors\s+'none'\s*(;|$)" "";
  default "frame-ancestors 'none'";
}

server_tokens off;
gzip on;
gzip_types text/plain text/css application/json application/javascript image/svg+xml;

# HTTP: only the ACME challenge (certificate issue and renewal); everything else goes to HTTPS.
server {
  listen 80 default_server;
  server_name _;
  access_log /var/log/nginx/access.log main_id;
  # Redirects and the ACME challenge need no keep-alive; an idle connection no limit counts would
  # hold a worker's slot otherwise (spec 0006 F36).
  keepalive_timeout 0;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  # The container's own health check.
  location = /nginx-health {
    access_log off;
    return 204;
  }

  location / {
    return 301 https://${SITE_DOMAIN}$request_uri;
  }
}

# HTTP/1.1 only, no `http2 on`: on a reload (every deploy, and every 6 hours for certificates) the
# old workers close HTTP/2 connections that carry no request yet, so a client that has just opened
# one loses its request. With HTTP/1.1 a request on a new connection is not lost; an idle keep-alive
# connection a reload closes is retried by browsers (spec 0004 E38).

# HTTPS for any other name (a bare IP, a stranger's domain): refuse the TLS handshake.
server {
  listen 443 ssl default_server;
  ssl_reject_handshake on;
}

server {
  listen 443 ssl;
  server_name www.${SITE_DOMAIN};
  access_log /var/log/nginx/access.log main_id;
  # A redirect only: no keep-alive, as on port 80.
  keepalive_timeout 0;
  ssl_certificate /etc/letsencrypt/live/${SITE_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SITE_DOMAIN}/privkey.pem;
  add_header Strict-Transport-Security "max-age=31536000" always;
  return 301 https://${SITE_DOMAIN}$request_uri;
}

server {
  listen 443 ssl;
  server_name ${SITE_DOMAIN};
  access_log /var/log/nginx/access.log main_id;

  # Mozilla "intermediate" TLS settings. No OCSP stapling: Let's Encrypt no longer runs OCSP.
  ssl_certificate /etc/letsencrypt/live/${SITE_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SITE_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  # HSTS: browsers that saw this use only HTTPS for the site for max-age seconds, and refuse even a
  # click-through on a certificate error. Raised step by step: 300 s (5 minutes) first, a year once
  # it has been seen working. Without includeSubDomains and preload: both are hard to take back.
  # `always` also sends it on error responses. A location with its own add_header would drop it.
  add_header Strict-Transport-Security "max-age=31536000" always;

  # The api reads at most BODY_LIMIT (100 KB, at most 1 MB) and web takes no uploads (spec 0006
  # F12). The photo upload spec opens a larger limit for its own route.
  client_max_body_size 1m;

  # An idle keep-alive connection is closed after 15 s, not the image's 65 s (spec 0006 F36).
  keepalive_timeout 15s;
  # At most 50 requests in progress per address; a location with its own limit_conn repeats this.
  limit_conn edge_conns 50;

  # nginx's own refusals answer in the api's error format, not with nginx's HTML pages (spec 0006
  # F12, F17), so web and browsers handle one format. An error_page in a location replaces these, so
  # a location that sets its own repeats them. The named locations set no add_header: one would drop
  # the server's (HSTS, X-Request-Id, the security headers), and nginx's 429 sends no Retry-After (the api's own does).
  # `types {}` keeps the type JSON: nginx would take it from the URI's extension (`/media/a.webp`).
  error_page 413 @payload_too_large;
  error_page 429 @too_many_requests;

  location @payload_too_large {
    types {}
    default_type application/json;
    return 413 '{"error":{"code":"PAYLOAD_TOO_LARGE","message":"The body is too large","details":[]}}';
  }
  location @too_many_requests {
    types {}
    default_type application/json;
    return 429 '{"error":{"code":"TOO_MANY_REQUESTS","message":"Too many requests, try again later","details":[]}}';
  }
  location @api_unavailable {
    types {}
    default_type application/json;
    return 503 '{"error":{"code":"SERVICE_UNAVAILABLE","message":"The api is unavailable, try again later","details":[]}}';
  }

  # The request id on every response, the api's own copy hidden so it is not doubled (spec 0006 F10).
  add_header X-Request-Id $request_id always;
  proxy_hide_header X-Request-Id;

  # Security headers on every response of api, web and nginx itself (spec 0006 F9). A few answers
  # carry a CSP of their own (Next's on /_next/image, Express's on Swagger's static files); browsers
  # apply both, so no proxy_hide_header: hiding Next's would drop its sandbox for images. web's pages
  # carry the full one, and nginx adds none to them ($edge_csp above). Not on the redirect servers
  # above: a 301 has nothing to frame or sniff (F38).
  add_header X-Content-Type-Options nosniff always;
  add_header Content-Security-Policy $edge_csp always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # The api's shared secret (spec 0006 F13), sent by proxy-headers.inc; `location /` empties it.
  set $proxy_secret "${PROXY_SECRET}";

  proxy_http_version 1.1;
  include /etc/nginx/conf.d/proxy-headers.inc;
  proxy_set_header Connection "";

  # Of the api's health checks only liveness is public: deploy.sh, smoke-test.sh and
  # request-loop.sh read it. Readiness names internal hosts and failure reasons, and deploy.sh
  # checks it from inside. Everything else under /api/health is refused, in any letter case: the
  # regex runs on the path nginx has already decoded and normalized (%2F, //, ..), and a regex
  # location wins over the /api/ prefix below.
  location = /api/health/live {
    limit_req zone=edge_health burst=100 nodelay;
    proxy_pass http://api/health/live;
  }
  location ~* ^/api/health {
    deny all;
  }

  # /api/ strips its prefix, so /api/socket.io/ would reach socket.io (long-polling) past the
  # socket limits of /socket.io/ below. A regex location wins over the /api/ prefix.
  location ~* ^/api/socket\.io {
    default_type application/json;
    return 404 '{"error":{"code":"ROUTE_NOT_FOUND","message":"Route not found","details":[]}}';
  }

  # Sign-in (Better Auth in the api, spec 0013 plan §9) keeps its prefix: no URI in proxy_pass, so
  # /api/auth/… reaches the api unchanged, where Better Auth matches it against its base URL. The
  # longer prefix wins over /api/ below, whose limits and error pages it repeats (error_page here
  # would replace the server's).
  location /api/auth/ {
    limit_req zone=edge_api burst=40 nodelay;
    proxy_pass http://api;
    proxy_read_timeout 60s;
    error_page 413 @payload_too_large;
    error_page 429 @too_many_requests;
    error_page 502 504 =503 @api_unavailable;
  }

  # The api without its /api prefix: /api/categories → /categories. Liveness above has its own zone, so the
  # deploy's request loop is never refused.
  location /api/ {
    limit_req zone=edge_api burst=40 nodelay;
    proxy_pass http://api/;
    # Above the api's longest answer: REQUEST_TIMEOUT_MS is at most 30 s, the throttler's Redis call
    # at most 1 s more, so the api answers 503 itself before nginx would answer 504 (spec 0006 F11).
    proxy_read_timeout 60s;
    # nginx's own 502 and 504 (no copy of the api answers, or it hangs) answer in the api's format
    # too (spec 0006 F33); the api's own errors pass unchanged (proxy_intercept_errors is off).
    # `=503`: a named location keeps the original status otherwise, whatever its `return` says.
    error_page 413 @payload_too_large;
    error_page 429 @too_many_requests;
    error_page 502 504 =503 @api_unavailable;
  }

  location /socket.io/ {
    # Long-polling makes a few requests before the upgrade; an open socket holds its connection for
    # its whole life, so limit_conn caps the sockets one address holds (spec 0006 F8). nginx does
    # not limit the size of WebSocket frames: the api does (SOCKET_MAX_MESSAGE_BYTES).
    limit_req zone=edge_socket burst=20 nodelay;
    limit_conn edge_sockets 10;
    limit_conn edge_conns 50;
    proxy_pass http://api;
    # A proxy_set_header in a location drops every one inherited from the server block, so the
    # shared ones are included again.
    include /etc/nginx/conf.d/proxy-headers.inc;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # Idle sockets must survive nginx's default 60 s read timeout.
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # The catalog media: /media/<key> is the bucket's media/<key>, which the bucket lets only this
  # server read, without a key (spec 0011 M3, M15). Read-only. A missing key's 404 is cached per
  # key, so random keys would each reach the bucket: edge_media holds them back (spec 0014 O39). No
  # add_header here: the server's would be dropped.
  location /media/ {
    # GET allows HEAD too. Any other method is refused, as the api refuses a method a route lacks.
    limit_except GET {
      deny all;
    }
    limit_req zone=edge_media burst=60 nodelay;
    # The key only: the query string stays here (the storage would act on one, e.g.
    # ?response-content-type= replaces the answer's type, M30) and is not in the cache key, so
    # it cannot split the cache. A key ending in / is a folder: the emulator answers it with an
    # empty object, nothing lists the bucket.
    rewrite ^/media/(.*[^/])$ /${S3_BUCKET}/media/$1? break;
    return 404;

    # A variable: resolved at request time, so nginx starts while the storage is unreachable.
    proxy_pass $s3_origin;
    # Nothing of the visitor's request goes to the storage: no header (the proxy secret, the
    # address, cookies), only the Host nginx sets. A proxy_set_header here also drops the server's.
    proxy_pass_request_headers off;
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    # The default 1 allows one intermediate; room for a longer chain if the storage changes CA.
    proxy_ssl_verify_depth 3;

    # The storage's own headers (AC2): request ids, the owner of a user's file, the emulator's,
    # Timeweb's (Ceph RGW), and those S3 sends for versions, encryption, lock and checksums.
    proxy_hide_header x-amz-id-2;
    proxy_hide_header x-amz-request-id;
    proxy_hide_header x-amz-meta-owner-user-id;
    proxy_hide_header x-amz-version-id;
    proxy_hide_header x-amz-delete-marker;
    proxy_hide_header x-amz-storage-class;
    proxy_hide_header x-amz-server-side-encryption;
    proxy_hide_header x-amz-expiration;
    proxy_hide_header x-amz-restore;
    proxy_hide_header x-amz-tagging-count;
    proxy_hide_header x-amz-mp-parts-count;
    proxy_hide_header x-amz-replication-status;
    proxy_hide_header x-amz-object-lock-mode;
    proxy_hide_header x-amz-object-lock-retain-until-date;
    proxy_hide_header x-amz-object-lock-legal-hold;
    proxy_hide_header x-amz-website-redirect-location;
    proxy_hide_header x-amz-checksum-crc32;
    proxy_hide_header x-amz-checksum-crc32c;
    proxy_hide_header x-amz-checksum-crc64nvme;
    proxy_hide_header x-amz-checksum-sha1;
    proxy_hide_header x-amz-checksum-sha256;
    proxy_hide_header x-amz-checksum-type;
    proxy_hide_header Seaweed-X-Amz-ETag;
    proxy_hide_header Seaweed-X-Amz-Owner;
    proxy_hide_header x-rgw-object-type;
    # The storage never sees the visitor's Origin, so its Vary: Origin would only split the cache.
    proxy_hide_header Vary;
    proxy_hide_header Set-Cookie;
    proxy_ignore_headers Set-Cookie Vary;

    # A missing key answers 403 (the policy allows no listing) or 404; both are 404 here, as is any
    # other refusal of the storage (a key too long, a bad byte): its XML body names the bucket. Not
    # 412 and 416: the storage gets no If-* or Range, they are nginx's own answers to a visitor's. A
    # location's error_page replaces the server's, so 413 and 429 are repeated.
    proxy_intercept_errors on;
    error_page 400 401 402 403 404 405 406 408 409 410 411 414 415 417 421 422 423 424 428 431 451
      = @media_not_found;
    error_page 500 501 502 503 504 =503 @media_unavailable;
    error_page 413 @payload_too_large;
    error_page 429 @too_many_requests;

    proxy_cache media;
    proxy_cache_key $proxy_host$uri;
    proxy_cache_valid 200 1d;
    proxy_cache_valid 403 404 1m;
    # A failing storage (no connection, a timeout, a 5xx) gets the cached copy, expired or not: a key
    # always names the same photo (the seed never rewrites one), so the copy is never wrong (M36).
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_lock on;
  }
  # limit_except's 403 lands here too: told apart by the method (M30).
  location @media_not_found {
    types {}
    default_type application/json;
    if ($request_method !~ ^(GET|HEAD)$) {
      return 404 '{"error":{"code":"ROUTE_NOT_FOUND","message":"Route not found","details":[]}}';
    }
    return 404 '{"error":{"code":"NOT_FOUND","message":"File not found","details":[]}}';
  }
  location @media_unavailable {
    types {}
    default_type application/json;
    return 503 '{"error":{"code":"SERVICE_UNAVAILABLE","message":"The storage is unavailable, try again later","details":[]}}';
  }

  # web's health route is for the container's health check only (spec 0014 O34), its warm-up list
  # for the deploy's step inside the container (spec 0018 plan §4): nothing under /healthz is public.
  location = /healthz {
    default_type application/json;
    return 404 '{"error":{"code":"ROUTE_NOT_FOUND","message":"Route not found","details":[]}}';
  }

  location ^~ /healthz/ {
    default_type application/json;
    return 404 '{"error":{"code":"ROUTE_NOT_FOUND","message":"Route not found","details":[]}}';
  }

  # web gets the address and the request id but not the secret: it has its own and forwards both
  # to the api with it. Pages (and their prefetches) count in edge_pages; Next's static files,
  # dozens per page and cached by the browser, do not ($edge_pages_key, spec 0014 plan §5).
  location / {
    limit_req zone=edge_pages burst=33 nodelay;
    set $proxy_secret "";
    proxy_pass http://web;
  }
}
