{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__code-rag__search_code",
      "mcp__code-rag__search_docs",
      "mcp__code-rag__index_status"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr lock:*)",
      "Bash(gh pr unlock:*)",
      "Bash(gh pr update-branch:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh issue transfer:*)",
      "Bash(gh issue lock:*)",
      "Bash(gh issue unlock:*)",
      "Bash(gh issue pin:*)",
      "Bash(gh issue unpin:*)",
      "Bash(gh issue develop:*)",
      "Bash(gh label:*)",
      "Bash(gh gist:*)",
      "Bash(gh variable:*)",
      "Bash(gh cache:*)",
      "Bash(gh ssh-key:*)",
      "Bash(gh gpg-key:*)",
      "Bash(gh project:*)",
      "Bash(gh codespace:*)",
      "Bash(gh attestation:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh run delete:*)",
      "Bash(gh workflow:*)",
      "Bash(gh release:*)",
      "Bash(gh repo:*)",
      "Bash(gh api -X:*)",
      "Bash(gh secret:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(ansible-playbook:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm install-scripts approve:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(npx prisma db:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose stop:*)",
      "Bash(docker compose start:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker image rm:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/vault.yml)",
      "mcp__mixpanel__Delete-Cohort",
      "mcp__mixpanel__Delete-Dashboard",
      "mcp__mixpanel__Delete-Tag",
      "mcp__mixpanel__Bulk-Edit-Events",
      "mcp__mixpanel__Bulk-Edit-Properties",
      "mcp__mixpanel__Merge-Group",
      "mcp__mixpanel__Dismiss-Duplicate-Group",
      "mcp__mixpanel__Dismiss-Issues",
      "mcp__mixpanel__Edit-Event",
      "mcp__mixpanel__Edit-Property",
      "mcp__mixpanel__Get-User-Replays-Data",
      "mcp__sentry__execute_sentry_tool",
      "mcp__sentry__search_sentry_tools",
      "mcp__sentry__update_issue",
      "mcp__sentry__add_issue_note",
      "mcp__sentry__link_issue",
      "mcp__sentry__unlink_issue",
      "mcp__sentry__onboarding_status_update",
      "mcp__sentry__create_project",
      "mcp__sentry__create_team",
      "mcp__sentry__create_dsn",
      "mcp__sentry__create_alert_rule",
      "mcp__sentry__create_metric_monitor",
      "mcp__sentry__create_uptime_monitor",
      "mcp__sentry__update_project",
      "mcp__sentry__update_dsn",
      "mcp__sentry__update_alert_rule",
      "mcp__sentry__update_metric_monitor",
      "mcp__sentry__update_uptime_monitor",
      "mcp__sentry__delete_alert_rule",
      "mcp__sentry__delete_metric_monitor",
      "mcp__sentry__delete_monitor_environment",
      "mcp__sentry__delete_uptime_monitor",
      "mcp__sentry__add_team_to_project",
      "mcp__sentry__remove_team_from_project",
      "mcp__sentry__analyze_issue_with_seer",
      "mcp__sentry__whoami",
      "mcp__sentry__search_replays",
      "mcp__sentry__use_sentry"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.mjs main || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh" }
        ]
      }
    ]
  }
}
